using System;

class Program {
    static void Main() {
        int[] marks = new int[5];
        Console.WriteLine("Enter marks for 5 subjects (Range: 0 to 100):");

        for (int i = 0; i < 5; i++) {
            try {
                Console.Write($"Subject {i + 1}: ");
                int mark = int.Parse(Console.ReadLine());

                if (mark < 0 || mark > 100) {
                    throw new ArgumentOutOfRangeException("Marks must be between 0 and 100.");
                }

                marks[i] = mark;
            }
            catch (FormatException) {
                Console.WriteLine("Invalid input! Please enter a numeric value. Try this subject again.");
                i--; // Repeat current iteration
            }
            catch (ArgumentOutOfRangeException ex) {
                Console.WriteLine($"Error: {ex.Message} Try this subject again.");
                i--; // Repeat current iteration
            }
        }

        Console.WriteLine("\n--- Marks Recorded Successfully ---");
        int total = 0;
        for (int i = 0; i < 5; i++) {
            Console.WriteLine($"Subject {i + 1}: {marks[i]}");
            total += marks[i];
        }
        Console.WriteLine($"Total Marks: {total} / 500");
        Console.WriteLine($"Percentage: {(total / 5.0)}%");
    }
}
