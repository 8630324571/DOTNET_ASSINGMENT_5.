using System;

class Program {
    static void Main() {
        int[] arr = { 10, 20, 30, 40, 50 };
        
        try {
            Console.WriteLine("Array created with 5 elements (Indices: 0 to 4).");
            Console.Write("Enter an index to access: ");
            int index = Convert.ToInt32(Console.ReadLine());
            
            Console.WriteLine($"Element at index {index}: {arr[index]}");
        }
        catch (IndexOutOfRangeException) {
            Console.WriteLine("Error: IndexOutOfRangeException! Please enter an index between 0 and 4.");
        }
        catch (FormatException) {
            Console.WriteLine("Error: Invalid input format. Please enter a valid integer index.");
        }
    }
}
